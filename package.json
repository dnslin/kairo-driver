{
  "name": "@kairo/driver",
  "version": "2.0.0",
  "description": "Pure, event-driven CDP driver for KK9 desktop client",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnslin/kairo-driver.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint",
    "prepack": "pnpm build",
    "dev": "tsx watch src/index.ts",
    "verify": "tsx examples/verify.ts",
    "diagnose": "tsx examples/diagnose.ts",
    "e2e": "tsx examples/e2e-real-test.ts",
    "e2e:media": "tsx examples/e2e-media.ts",
    "e2e:stage1": "tsx examples/e2e-stage1-contract.ts"
  },
  "dependencies": {
    "@audio/decode-mp3": "^1.3.1",
    "@audio/decode-wav": "^1.5.0",
    "mime-types": "^3.0.2",
    "node-edge-tts": "^1.2.10",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "wave-resampler": "^1.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.12.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
